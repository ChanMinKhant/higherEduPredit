modules = ["python-3.11", "nodejs-20"]

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]

[deployment]
deploymentTarget = "autoscale"
run = ["streamlit", "run", "app.py", "--server.port", "5000"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ML Console App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "main"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Prediction Console"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Web Application"

[[workflows.workflow]]
name = "ML Console App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "main"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv add scikit-learn && python main.py"

[[workflows.workflow]]
name = "Prediction Console"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python predict.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Web Application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python web_app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80
